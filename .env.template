# ==============================================================================
# APP CONFIGURATION
# ==============================================================================
# Хост, на котором запускается приложение (по умолчанию: localhost)
HOST=localhost

# Порт для запуска приложения (по умолчанию: 8080)
PORT=8080

# Тип хранилища: 'inmemory', 'postgres' и т.д. (по умолчанию: inmemory)
STORAGE_TYPE=inmemory

# Разрешенные CORS-ориджины. Если их несколько, обычно указываются через запятую (по умолчанию: *)
ALLOWED_ORIGINS=*


# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Хост базы данных (по умолчанию: localhost)
DB_HOST=localhost

# Порт базы данных (по умолчанию: 5432)
DB_PORT=5432

# Имя пользователя БД (по умолчанию: postgres)
DB_USER=postgres

# Пароль пользователя БД (по умолчанию: postgres)
DB_PASS=postgres

# Имя базы данных (по умолчанию: url_shortener_db)
DB_NAME=url_shortener_db